version: 0.2

phases:
  install:
    runtime-versions:
      python: 3.8
    commands:
      - echo "Installing dependencies..."
      - pip install -r requirements.txt

  build:
    commands:
      - echo "Running tests..."
      - python -m unittest discover

  post_build:
    commands:
      - echo "Build complete, packaging artifact..."
      - zip -r application.zip app.py requirements.txt deploy.sh

artifacts:
  files:
    - application.zip